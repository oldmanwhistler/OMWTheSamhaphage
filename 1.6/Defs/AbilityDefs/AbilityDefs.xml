        <iconPath>UI/Icons/Genes/AG_UnstableMutation</iconPath>
        <cooldownTicksRange>60000</cooldownTicksRange>
        <comps>
            <li Class="AlphaGenes.CompProperties_GiveHediff">
                <hediffDef>OMW_UnstableMutation</hediffDef>
            </li>
        </comps>
    </AbilityDef>
    
</Defs>