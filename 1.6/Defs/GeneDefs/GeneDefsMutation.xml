<?xml version="1.0" encoding="utf-8" ?>
<Defs MayRequire="Ludeon.RimWorld.Biotech">
    <GeneDef>
        <defName>OMW_UnstableMutation</defName>
        <label>unstable mutation</label>
        <description>Carriers of this gene can force an unstable mutation on their bodies once per day. This mutation will activate a new random gene for 12 hours. The genes will only deactivate if they are an xenogene. Endogenes will persist.</description>
        <iconPath>UI/Icons/Genes/AG_UnstableMutation</iconPath>
        <displayCategory>OMW_PerfectSilence</displayCategory>
        <statFactors>
            <CancerRate>3</CancerRate>
        </statFactors>
        <abilities>
            <li>OMW_UnstableMutation</li>
        </abilities>
        <exclusionTags>
            <li>AG_UnstableMutations</li>
        </exclusionTags>
        <selectionWeight>0</selectionWeight>
        <descriptionHyperlinks>
            <AbilityDef>OMW_UnstableMutation</AbilityDef>
        </descriptionHyperlinks>
        <biostatMet>-2</biostatMet>
        <biostatCpx>1</biostatCpx>
        <modExtensions>
            <li Class="VEF.Genes.GeneExtension">
                <backgroundPathEndogenes>UI/Icons/Genes/AG_Endogenes</backgroundPathEndogenes>
                <backgroundPathXenogenes>UI/Icons/Genes/AG_Xenogenes</backgroundPathXenogenes>
            </li>
        </modExtensions>
    </GeneDef>
    <GeneDef>
        <defName>OMW_UnstableMutationMinor</defName>
        <label>unstable mutation, minor</label>
        <exclusionTags>
            <li>AG_UnstableMutations</li>
        </exclusionTags>
        <description>Carriers of this gene will suffer an unstable mutation on their bodies once per day. This mutation will activate new random genes for the whole day. Next day, new genes will take their place. The genes will only deactivate if they are an xenogene. Endogenes will persist.</description>
        <iconPath>UI/Icons/Genes/AG_UnstableMutationMinor</iconPath>
        <displayCategory>OMW_PerfectSilence</displayCategory>
        <displayOrderInCategory>114</displayOrderInCategory>
        <statFactors>
            <CancerRate>5</CancerRate>
        </statFactors>
        <biostatMet>-4</biostatMet>
        <biostatCpx>2</biostatCpx>
        <selectionWeight>0</selectionWeight>
        <modExtensions>
            <li Class="VEF.Genes.GeneExtension">
                <backgroundPathEndogenes>UI/Icons/Genes/AG_Endogenes</backgroundPathEndogenes>
                <backgroundPathXenogenes>UI/Icons/Genes/AG_Xenogenes</backgroundPathXenogenes>
                <hediffToWholeBody>OMW_UnstableMutationMinor</hediffToWholeBody>
            </li>
        </modExtensions>
    </GeneDef>

