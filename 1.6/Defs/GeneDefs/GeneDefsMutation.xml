<?xml version="1.0" encoding="utf-8" ?>
<Defs MayRequire="Ludeon.RimWorld.Biotech">
    <GeneDef ParentName="OMW_SamhaphageGeneBase">
        <defName>OMW_Mutation_1_FrequencyBleed</defName>
        <label>Frequency Bleed</label>
        <description>
        Once per day, the carrier can force a volatile, random genetic signal to manifest within their flesh. This temporary broadcast runs for exactly 12 hours. The manifested signal is a superficial xenogene, and lacks the foundational grounding to sustain itself. After 12 hours, the transmission loses amplitude, the channel closes, and the gene fades back into quiet static</description>
        <customEffectDescriptions>
            <li>If the xenogene is converted to an endogene, it will persist.</li>
        </customEffectDescriptions>        
        <iconPath>UI/Icons/Genes/OMW_Mutation_1_FrequencyBleed</iconPath>
        <statFactors>
            <CancerRate>3</CancerRate>
        </statFactors>
        <abilities>
            <li>OMW_Mutation_1_FrequencyBleed</li>
        </abilities>
        <exclusionTags>
            <li>OMW_Mutation_1_FrequencyBleed</li>
        </exclusionTags>
        <selectionWeight>0</selectionWeight>
        <descriptionHyperlinks>
            <AbilityDef>OMW_Mutation_1_FrequencyBleed</AbilityDef>
        </descriptionHyperlinks>
        <biostatMet>-2</biostatMet>
        <biostatCpx>1</biostatCpx>
    </GeneDef>
    
    <GeneDef ParentName="OMW_SamhaphageGeneBase">
        <defName>OMW_Mutation_2_SpectrumInterference</defName>
        <label>Spectrum Interference</label>
        <statFactors>
            <CancerRate>10</CancerRate>
        </statFactors>
        <exclusionTags>
            <li>AG_UnstableMutations</li>
        </exclusionTags>
        <description>Every 24 hours, a massive wave of external static sweeps through the host's sequence, washing away the previous day's aberrations and forcing a completely new, randomized suite of xenogenes into active expression.</description>
                <customEffectDescriptions>
            <li>If the xenogene is converted to an endogene, it will persist.</li>
        </customEffectDescriptions>  
        <iconPath>UI/Icons/Genes/OMW_Mutation_2_SpectrumInterference</iconPath>
        <displayOrderInCategory>114.1</displayOrderInCategory>
        <biostatMet>0</biostatMet>
        <biostatCpx>0</biostatCpx>
        <selectionWeight>0</selectionWeight>
        <displayCategory>OMW_PerfectSilence</displayCategory>
		<modExtensions>
			<li Class="VEF.Genes.GeneExtension">
				<backgroundPathEndogenes>UI/Icons/Genes/OMW_Samhaphage_Endogenes</backgroundPathEndogenes>
				<backgroundPathXenogenes>UI/Icons/Genes/OMW_Samhaphage_Xenogenes</backgroundPathXenogenes>
                <hediffToWholeBody>OMW_Mutation_2_SpectrumInterference</hediffToWholeBody>
            </li>
        </modExtensions>
    </GeneDef>

