<?xml version="1.0" encoding="utf-8" ?>
<Defs MayRequire="Ludeon.RimWorld.Biotech">

  <GeneDef ParentName="OMW_SamhaphageGeneBase">
    <defName>OMW_Fluxspawn_Nudist</defName>
    <label>slime-slicked</label>
    <displayCategory>OMW_PerfectSilence</displayCategory>
    <description>The epidermal layer of this subspecies is a semi-permeable, hyper-active membrane. Constant mutagenic secretion and rapid cellular flux mean the body’s volume fluctuates by several liters per hour. To these creatures, clothing is not just a nuisance — it is a restrictive, suffocating cage that becomes a sodden, abrasive hazard within minutes of being donned.</description>
    <iconPath>UI/Icons/Genes/OMW_SlugNudity</iconPath>
    <displayOrderInCategory>1</displayOrderInCategory>
    <biostatCpx>3</biostatCpx>
    <biostatMet>3</biostatMet>
    <statOffsets>      
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>    
      <ComfyTemperatureMax>+60</ComfyTemperatureMax>
    </statOffsets>         
    <forcedTraits>
      <li>
        <def>Nudist</def>
      </li>
    </forcedTraits>
  </GeneDef>


  <GeneDef ParentName="FertilityBase">
    <defName>OMW_Fluxspawn_Ferility</defName>
    <label>disgustingly fertile</label>
    <description>The slugs just... don't... stop... ugh.</description>
    <iconPath>UI/Icons/Genes/OMW_DisgustinglyFertile</iconPath>
    <displayOrderInCategory>110</displayOrderInCategory>
    <biostatCpx>4</biostatCpx>
    <biostatMet>4</biostatMet>
    <statFactors>
      <Fertility>20</Fertility>
    </statFactors>
    <displayCategory>OMW_PerfectSilence</displayCategory>
		<modExtensions>
			<li Class="VEF.Genes.GeneExtension">
				<backgroundPathEndogenes>UI/Icons/Genes/OMW_Samhaphage_Endogenes</backgroundPathEndogenes>
				<backgroundPathXenogenes>UI/Icons/Genes/OMW_Samhaphage_Xenogenes</backgroundPathXenogenes>
			</li>
		</modExtensions>    
  </GeneDef>

  <GeneDef ParentName="OMW_SamhaphageGeneBase">
    <defName>OMW_FluxSpawn_Hiveling_Frame</defName>
    <label>null condensation</label>
    <iconPath>UI/Icons/Genes/BodyFluxspawnHiveling</iconPath>
    <description>Hyper-condensed genome. This gene reduces the carrier to a small scale, trading physical durability for extreme elusiveness. Despite their fist-sized stature, their muscles vibrate with the strength of the Null-Thrum, allowing them to haul twice the weight of a full-grown man. They function as the sensory fringe of the Pulsing Silence, vibrating so rapidly that they appear as neon-purple smears against the landscape.</description>
    <displayOrderInCategory>9999</displayOrderInCategory>
    <biostatCpx>5</biostatCpx>
    <biostatMet>8</biostatMet>
    <biostatArc>1</biostatArc>
    <selectionWeight>0.1</selectionWeight>

    <immuneToVacuumBurns>true</immuneToVacuumBurns>   
    <statOffsets>    
      <VacuumResistance MayRequire="ludeon.rimworld.odyssey">0.8</VacuumResistance>
      <SM_RaidWealthOffset>10000.0</SM_RaidWealthOffset>
      <SM_HeadSize_Cosmetic>-0.1</SM_HeadSize_Cosmetic>
      <MeleeDodgeChance>50</MeleeDodgeChance>
      <MeleeHitChance>30</MeleeHitChance>   
    </statOffsets>

    <statFactors>
      <LifespanFactor>1.3</LifespanFactor>
      <SM_BodySizeMultiplier>0.05</SM_BodySizeMultiplier>
      <SM_RaidWealthMultiplier>2000.0</SM_RaidWealthMultiplier>
      <IncomingDamageFactor>1.5</IncomingDamageFactor>
      <MeleeDamageFactor>0.5</MeleeDamageFactor>
      <CarryingCapacity>40</CarryingCapacity>
      <EatingSpeed>5</EatingSpeed>
      <MoveSpeed>1.8</MoveSpeed>          
    </statFactors>

		<abilities>
			<li>OMW_AbilityFluxspawnSelf</li>
			<li>OMW_AbilityFluxspawnTargetPawn</li>
			<li>OMW_AbilityFluxspawnTargetCorpse</li>
		</abilities>
		<descriptionHyperlinks>
			<AbilityDef>OMW_AbilityFluxspawnSelf</AbilityDef>
			<AbilityDef>OMW_AbilityFluxspawnTargetPawn</AbilityDef>
			<AbilityDef>OMW_AbilityFluxspawnTargetCorpse</AbilityDef>      
		</descriptionHyperlinks>
  </GeneDef>

