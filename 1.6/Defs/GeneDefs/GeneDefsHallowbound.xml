<?xml version="1.0" encoding="utf-8" ?>
<Defs MayRequire="Ludeon.RimWorld.Biotech">

  <GeneDef ParentName="OMW_SamhaphageGeneBase">
    <defName>OMW_Hallowbound_Frame</defName>
    <label>harrowed geometry</label>
   <iconPath>UI/Icons/Genes/BodyHallowbound</iconPath>
    <description>The subjects physiology has been "harrowed" into a lanky frame. By stripping away the soft markers of individuality, the skeleton is elongated and thinned until the body possesses an unsettling grace. Their face is featureless except for the facial ridges that ripple when the creature consumes.</description>
    <displayOrderInCategory>9999</displayOrderInCategory>
    <biostatCpx>4</biostatCpx>
    <biostatMet>-3</biostatMet>
    <biostatArc>1</biostatArc>
    <selectionWeight>0.3</selectionWeight>

    <statOffsets>
      <SM_HeadSize_Cosmetic>0.08</SM_HeadSize_Cosmetic>
    </statOffsets>

    <statFactors>
      <SM_BodySizeMultiplier>1.1</SM_BodySizeMultiplier>
      <EatingSpeed>2</EatingSpeed>
      <MoveSpeed>1.2</MoveSpeed>          
    </statFactors>

		<abilities>
			<li>OMW_AbilityHallowboundSelf</li>
			<li>OMW_AbilityHallowboundTargetPawn</li>
			<li>OMW_AbilityHallowboundTargetCorpse</li>
		</abilities>
		<descriptionHyperlinks>
			<AbilityDef>OMW_AbilityHallowboundSelf</AbilityDef>
			<AbilityDef>OMW_AbilityHallowboundTargetPawn</AbilityDef>
			<AbilityDef>OMW_AbilityHallowboundTargetCorpse</AbilityDef>      
		</descriptionHyperlinks>

  </GeneDef>

  <GeneDef ParentName="OMW_SamhaphageGeneBase">
    <defName>OMW_Hallowbound_EntropyWell</defName>
    <label>entropy well</label>
    <description>Their metabolism operates at a frequency so low that molecular friction and body heat are negligible. It makes their flesh takes on the texture of cold, waxy tallow. They are unsettling to the touch but it allows them to work tirelessly in sub-zero temperatures where baseliners would fail.</description>
    <iconPath>UI/Icons/Genes/EntropyWell</iconPath>
    <displayOrderInCategory>1</displayOrderInCategory>
    <biostatCpx>3</biostatCpx>
    <biostatMet>-2</biostatMet>
    <immuneToVacuumBurns>true</immuneToVacuumBurns>    
    <statOffsets>
      <VacuumResistance MayRequire="ludeon.rimworld.odyssey">0.25</VacuumResistance>    
      <ComfyTemperatureMin>-15</ComfyTemperatureMin>      
      <ComfyTemperatureMax>+5</ComfyTemperatureMax>
    </statOffsets>         
  </GeneDef>

</Defs>